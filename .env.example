# ─── Banco de dados (PostgreSQL — Neon) ───────────────────
# Use uma branch de desenvolvimento do Neon localmente; a de produção
# fica só nas variáveis de ambiente da Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="GERE_UMA_CHAVE_FORTE_AQUI"

# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"
# Em produção: NEXTAUTH_URL="https://seu-projeto.vercel.app"

# ─── Anexos de tarefas (Vercel Blob) ──────────────────────
# Sem esta variável o upload de anexos responde 503.
BLOB_READ_WRITE_TOKEN=""

# ─── E-mail do relatório (Gmail) ──────────────────────────
# EMAIL_PASS é uma "senha de app" do Google, não a senha da conta.
EMAIL_USER=""
EMAIL_PASS=""
# Remetente exibido (opcional). Padrão: "Chronos PM <EMAIL_USER>"
EMAIL_FROM=""
